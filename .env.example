# Copy to .env. Leave login blank to attach to the Exness MT5 terminal
# you already logged into. That is the safer demo setup.

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial
# Path to the Exness terminal. Leave blank to use the running terminal.
MT5_PATH=

# Exact Market Watch names if you know them. Common Exness names:
#   Standard: EURUSDm, XAUUSDm
#   Raw Spread / Zero: EURUSD, XAUUSD
SYMBOLS=EURUSD,XAUUSD

# Safety gates. Live orders are off until you set LIVE_TRADING=true.
# Real accounts are refused until ALLOW_REAL_ACCOUNT=true.
LIVE_TRADING=false
ALLOW_REAL_ACCOUNT=false

# Exness server clock minus UTC, in hours. Trial servers are often +2 or +3.
# Run: python -m exness_mt5_agent check
BROKER_UTC_OFFSET=2

# Copy data/news_events.example.csv to data/news_events.csv and replace it
# with a real high-impact calendar before live demo trading.
NEWS_CALENDAR=data/news_events.csv
NEWS_FILTER_ENABLED=true

RISK_PCT=0.01
MAX_DAILY_LOSS=0.03
SL_ATR=1.5
TP_ATR=3.0
PROBA_THRESHOLD=0.70
HORIZON_BARS=12

# Round-turn commission in account currency, per 1.00 lot.
# Standard accounts are usually 0 (cost is in the spread).
# Raw Spread is not free: set the figure from your Exness contract spec.
COMMISSION_PER_LOT=0

DEVIATION_POINTS=50
MAX_SPREAD_POINTS_EURUSD=30
MAX_SPREAD_POINTS_XAUUSD=80

MODEL_TYPE=xgboost
HISTORY_BARS=20000
MAGIC=260106
MAX_LOTS=20
